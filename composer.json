{
    "name": "nexxtmove/ai",
    "license": "MIT",
    "require": {
        "prism-php/prism": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.4",
        "pestphp/pest": "^3.8",
        "laravel/pint": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "Nexxtmove\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexxtmove\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexxtmove\\AIServiceProvider"
            ],
            "aliases": {
                "AI": "Nexxtmove\\AI"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    }
}
